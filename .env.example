# Кавычки не нужны. После правок: systemctl restart rune-bot

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAF...

# Платёжный токен из BotFather → Payments (не ключ live_ из кабинета ЮKassa)
PAYMENT_TOKEN=

# Ваш Telegram ID, только цифры
ADMIN_ID=297967650

# Ваш числовой ID в MAX (для /grant и /allow_ritual inf)
MAX_ADMIN_ID=

REDIS_HOST=localhost
REDIS_PORT=6379

# Токен бота MAX (после модерации). Пока пустой — процесс ждёт.
MAX_BOT_TOKEN=

# URL мини-приложения из кабинета MAX (Чат-боты → Расширенные настройки)
MAX_MINIAPP_URL=https://Bochok100.github.io/rune/app.html

# Имя бота MAX без @ (подставляется само из API, можно задать вручную)
MAX_BOT_USERNAME=
